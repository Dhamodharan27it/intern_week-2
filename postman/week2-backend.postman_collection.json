              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Week 2\",\n  \"content\": \"Build backend APIs with Node.js and MongoDB.\"\n}"
            },
            "url": "http://localhost:5003/api/notes"
          }
        },
        {
          "name": "Update Note",
          "request": {
