        {
          "name": "List Notes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{notesToken}}"
              }
            ],
            "url": "http://localhost:5003/api/notes"
          }
        },
        {
          "name": "Create Note",
          "request": {
