              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Week 2 \u2013 Completed\"\n}"
            },
            "url": "http://localhost:5003/api/notes/{{noteId}}"
          }
        },
        {
          "name": "Delete Note",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{notesToken}}"
              }
            ],
            "url": "http://localhost:5003/api/notes/{{noteId}}"
          }
        }
      ]
    }
  ]
}